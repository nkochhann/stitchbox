{
  "name": "stitchbox",
  "version": "0.0.3",
  "description": "Simple, type-safe app composition for TypeScript.",
  "keywords": [
    "compose",
    "composer",
    "composition",
    "composition-root",
    "root",
    "container",
    "service-provider",
    "provider",
    "app-container",
    "app",
    "typescript",
    "simple",
    "dependency",
    "dependency-composition",
    "stitch",
    "box",
    "stitchbox"
  ],
  "homepage": "https://github.com/nkochhann/stitchbox#readme",
  "bugs": {
    "url": "https://github.com/nkochhann/stitchbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkochhann/stitchbox.git"
  },
  "license": "MIT",
  "author": "Nícolas Kochhann",
  "type": "module",
  "main": "index.ts",
  "directories": {
    "test": "tests"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "tsx --test ./tests/unit/*.test.ts",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "expect-type": "^1.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
